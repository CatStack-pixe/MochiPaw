{
  "identifier": "com.CatStack.MochiPaw",
  "bundle": {
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "110.0.1531.0",
      "wix": {
        "fragmentPaths": ["packaging/windows/data-access.wxs"],
        "componentRefs": ["MochiPawDataDirectory"]
      },
      "nsis": {
        "languages": [
          "English",
          "Vietnamese",
          "PortugueseBR",
          "SimpChinese",
          "TradChinese"
        ],
        "installMode": "both",
        "displayLanguageSelector": true,
        "installerHooks": "packaging/windows/data-access.nsh"
      }
    }
  }
}
